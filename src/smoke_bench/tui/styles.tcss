Screen {
    background: #171719;
    color: #dedee3;
}

#screen {
    width: 100%;
    height: 100%;
    padding: 1 2;
    background: #171719;
}

.section-title, .dashboard-title {
    color: #f1f1f4;
    text-style: bold;
    margin-bottom: 1;
}

.dashboard-title {
    padding-left: 1;
    color: #f4f4f6;
}

.help, .model-status {
    color: #92929b;
}

.error { color: #ff6b6b; }
.success { color: #a3e635; }
.warning { color: #f6b73c; }

.subsection-title {
    color: #a3e635;
    text-style: bold;
    padding: 1 0;
    margin: 0;
}

/* ── Advanced screen grid layout ─────────────────────────── */

#advanced-scroll {
    height: 1fr;
    min-height: 5;
}

.advanced-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 3fr 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
}

.advanced-grid .field-input {
    min-width: 8;
}

.grid-header {
    color: #a3e635;
    text-style: bold;
    padding: 0;
}

.full-row {
    column-span: 3;
}

.action-row {
    height: auto;
    margin: 1 0 0 0;
}

/* ── Input + inline reset button wrapper ─────────────────── */

.input-wrap {
    height: auto;
}

.input-wrap .field-input {
    width: 1fr;
    min-width: 8;
}

.input-wrap .reset-inside {
    width: 3;
    min-width: 3;
    height: 3;
    background: transparent;
    border: none;
    color: #63636c;
    margin-left: -1;
    padding: 0;
}

.input-wrap .reset-inside:hover {
    color: #a3e635;
    background: transparent;
}

/* ── Global settings labels ──────────────────────────────── */

.global-label {
    color: #c5c5ca;
    padding: 0 1 0 0;
}

Label {
    color: #c5c5ca;
}

Input, Select, TextArea {
    background: #202024;
    border: tall #44444b;
    color: #eeeeef;
}

Input:focus, Select:focus, TextArea:focus {
    border: tall #a3e635;
}

Button {
    background: #35353b;
    border: none;
    color: #f1f1f2;
    text-style: bold;
}

Button:hover, Button:focus {
    background: #4a4a52;
}

Button.-primary, Button.-success {
    background: #a3e635;
    color: #161617;
}

Button.-warning {
    background: #f6b73c;
    color: #161617;
}

Button.-error {
    background: #ff6b6b;
    color: #161617;
}

Checkbox, RadioButton {
    color: #d8d8dc;
}

Checkbox:focus, RadioButton:focus {
    color: #a3e635;
}

DataTable {
    height: 1fr;
    min-height: 5;
    background: #242428;
    color: #d8d8dd;
    border: none;
}

DataTable > .datatable--header {
    background: #a3e635;
    color: #151516;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #3a3a3f;
    color: #ffffff;
}

#boxes, #form, #bars {
    height: 1fr;
    min-height: 5;
    overflow-y: auto;
}

#status {
    margin: 0 0 1 0;
}

Horizontal {
    height: auto;
}

#actions {
    height: auto;
    margin: 1 0;
}

#summary, #current {
    height: auto;
}

HelpBar {
    height: 1;
    dock: bottom;
    background: #242428;
    color: #92929b;
    padding: 0 1;
}

/* Live benchmark dashboard */
#dashboard-scroll {
    width: 100%;
    height: 1fr;
    overflow-x: auto;
    overflow-y: hidden;
}

#dashboard {
    width: 148;
    min-width: 148;
    height: 100%;
    background: #171719;
}

#progress-panel {
    width: 30;
    min-width: 30;
    height: 100%;
    margin-right: 1;
}

#dashboard-main {
    width: 116;
    min-width: 116;
    height: 100%;
}

.dashboard-panel {
    background: #242428;
    border: round #4c5038;
    padding: 0;
}

.dashboard-panel > CollapsibleTitle {
    background: #242428;
    color: #a3e635;
    text-style: bold;
    padding: 0 1;
}

.dashboard-panel > Contents {
    padding: 1;
    background: #242428;
}

#progress-panel > Contents {
    height: 1fr;
}

#model-progress {
    height: 1fr;
    overflow-y: auto;
}

.model-name {
    color: #f0f0f2;
    text-style: bold;
    margin-top: 1;
}

.model-status {
    margin: 0 0 1 1;
}

.model-spacer {
    height: 1;
}

ProgressBar {
    color: #a3e635;
    background: #35353a;
    margin: 0 1;
}

#results-panel {
    height: 2fr;
    min-height: 10;
    margin-bottom: 1;
}

#results-panel > Contents {
    height: 1fr;
}

#log-panel {
    height: 1fr;
    min-height: 6;
}

#log-panel > Contents {
    height: 1fr;
}

#log {
    height: 1fr;
    background: #0e0e10;
    color: #d6d6db;
    border: tall #35353a;
}

#run-actions {
    height: auto;
    min-height: 3;
    margin: 1 0 0 0;
    align: right middle;
}

#run-status {
    width: 1fr;
    padding: 0 1;
}

Screen.-wide #dashboard {
    width: 100%;
    min-width: 100%;
}

Screen.-wide .dashboard-panel > Contents {
    padding: 1;
}

Screen.-wide #progress-panel,
Screen.-wide #dashboard-main,
Screen.-wide .dashboard-panel {
    height: 100%;
}

/* A collapsed panel is only its title. Its siblings reclaim the space. */
#results-panel.-collapsed,
#log-panel.-collapsed {
    height: auto;
    min-height: 0;
}

Screen.-wide #progress-panel.-collapsed {
    width: auto;
    min-width: 0;
    height: auto;
    margin-right: 1;
}

Screen.-wide #dashboard-main {
    width: 1fr;
    min-width: 0;
}

Screen.-narrow #screen {
    padding: 1;
}

Screen.-narrow #dashboard-scroll {
    overflow-x: hidden;
    overflow-y: auto;
}

Screen.-narrow #dashboard {
    width: 100%;
    min-width: 100%;
    height: auto;
    layout: vertical;
}

Screen.-narrow #progress-panel,
Screen.-narrow #dashboard-main {
    width: 100%;
    min-width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

Screen.-narrow #results-panel,
Screen.-narrow #log-panel {
    height: auto;
    min-height: 0;
}

Screen.-narrow #results-panel > Contents,
Screen.-narrow #log-panel > Contents {
    height: 16;
}

/* Keep the other panel headers reachable while Progress is expanded. */
Screen.-narrow #progress-panel > Contents {
    height: 10;
}

Screen.-narrow .dashboard-panel.-collapsed {
    height: auto;
    min-height: 0;
}

Screen.-narrow #run-actions {
    margin-top: 1;
}
